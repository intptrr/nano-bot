# Telegram bot token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=your-bot-token-from-botfather

# Comma-separated Telegram chat IDs to notify (message /start to your bot to discover yours)
CHAT_IDS=123456789

# Location for the forecast (city name; geocoded via Open-Meteo)
LOCATION_NAME=Bellevue, WA

# IANA timezone for the morning notification
TIMEZONE=America/Los_Angeles

# Local time of day to send the morning forecast (24h HH:MM)
NOTIFY_TIME=08:00

# Comma-separated tickers for the daily market report (Yahoo Finance symbols)
TICKERS=SPY,VIX,MSFT
